# Copy this file to .env and fill in your real values.
# The .env file is listed in .gitignore and will never be committed to Git.

# ── Nasdaq Data Link ──────────────────────────────────────────────────────────
# Get your free API key at: https://data.nasdaq.com/sign-up
NASDAQ_DATA_LINK_API_KEY=your_key_here

# ── Data provider selection ───────────────────────────────────────────────────
# Options: yfinance | sample | nasdaq_data_link
# "yfinance" = REAL market data, completely free, no API key required (RECOMMENDED)
# "sample"   = synthetic test data only — NOT for real research
DATA_PROVIDER=yfinance

# ── Database path (optional override) ────────────────────────────────────────
# Defaults to data/stock_analysis.db if not set.
# DATABASE_PATH=data/stock_analysis.db
